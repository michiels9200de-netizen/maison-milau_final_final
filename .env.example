# ==============================================================================
# MAISON MILAU · ENVIRONMENT CONFIGURATION (VERCEL & CLOUD RUN)
# Configureer deze variabelen in uw Vercel Project Dashboard (Settings > Environment Variables)
# ==============================================================================

# MOLLIE API Key (Vereist voor betalingen, webhooks en orders)
# Verkrijgbaar via: https://my.mollie.com/dashboard/developers/api-keys
# Test: test_... | Productie: live_...
MOLLIE_API_KEY="live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Publieke URL van uw Vercel deployment of eigen domein
# Bijv: https://maison-milau.vercel.app of https://www.maison-milau.be
APP_URL="https://www.maison-milau.be"
SITE_URL="https://www.maison-milau.be"

# (Optioneel) Gemini API Key voor AI Coffee Sommelier assistent
GEMINI_API_KEY=""

# (Optioneel) Contact & Notificaties
SUPPORT_EMAIL="michiels.laurent@yahoo.com"

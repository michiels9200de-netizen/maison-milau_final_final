# ==============================================================================
# MAISON MILAU · ENVIRONMENT CONFIGURATION (VERCEL & CLOUD RUN)
# Configureer deze variabelen in uw Vercel Project Dashboard (Settings > Environment Variables)
# ==============================================================================

# MOLLIE API Key (Vereist voor betalingen, webhooks en orders)
# Verkrijgbaar via: https://my.mollie.com/dashboard/developers/api-keys
# Test: test_... | Productie: live_...
MOLLIE_API_KEY="live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Publieke URL van uw Vercel deployment of eigen domein
# Bijv: https://maison-milau.vercel.app of https://www.maison-milau.be
APP_URL="https://www.maison-milau.be"
SITE_URL="https://www.maison-milau.be"

# (Optioneel) Gemini API Key voor AI Coffee Sommelier assistent
GEMINI_API_KEY=""

# ==============================================================================
# EMAIL & SMTP CONFIGURATIE (PRODUCTIE)
# ==============================================================================
# E-mailadres voor administratieve notificaties en klantenservice
ADMIN_EMAIL="maisonmilau@gmail.com"
SUPPORT_EMAIL="maisonmilau@gmail.com"

# SMTP Server instellingen (Google Workspace / Gmail SMTP)
# Voor Gmail: Genereer een Google App-wachtwoord via Google Account Beveiliging > 2-stapsverificatie > App-wachtwoorden
SMTP_HOST="smtp.gmail.com"
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="maisonmilau@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"

# Afzender weergavenaam & adres
SENDER_NAME="Maison Milau"
SENDER_EMAIL="maisonmilau@gmail.com"

# ==============================================================================
# ADMINISTRATOR BEVEILIGING
# ==============================================================================
# Beheerderswachtwoord voor toegang tot het Maison Milau beheerpaneel
ADMIN_PASSWORD=

# ==============================================================================
# PRODUCTIE DATABASE & AUTHENTICATIE (VERCEL / SUPABASE / POSTGRESQL)
# ==============================================================================
# Optie 1: Supabase (Aanbevolen voor Vercel)
# Verkrijgbaar via: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Optie 2: PostgreSQL / Neon / Vercel Postgres Connection String
# Verkrijgbaar via Vercel Storage tab > Postgres of Neon Console
DATABASE_URL=
POSTGRES_URL=

# Sessie & Token Beveiliging (HMAC SHA-256 geheim voor stateless sessies)
SESSION_SECRET=

